# Copy to .env and fill in only the providers you actually want to use.
# DEV never commits this file, and nothing runs for a provider whose key is absent.
# Every provider below is optional: DEV works with none of them set, using local
# models through Ollama or plain shell tasks.

# --- Free tiers: a good place to start -------------------------------------
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=
MISTRAL_API_KEY=
ZAI_API_KEY=

# A GitHub token with the models:read scope enables GitHub Models.
GITHUB_TOKEN=

# --- Paid providers: disabled by default, enable them in Settings ----------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Local models ----------------------------------------------------------
# Ollama needs no key. Set this only if it is not on the default address.
# OLLAMA_HOST=http://127.0.0.1:11434

# --- Where DEV keeps its own state --------------------------------------------
# Database, logs, artifacts and config live in .dev-home/ beside the repository.
# Set this to put them somewhere else (a faster disk, a shared folder you own).
# DEV_HOME=D:/dev-home
